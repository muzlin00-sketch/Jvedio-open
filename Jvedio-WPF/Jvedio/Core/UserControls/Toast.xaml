<!--
    ============================================================
    Toast —— 应用内轻提示
    ============================================================

    ## 为什么不用 SuperControls.Style.MessageNotify

    闭源库的 MessageNotify 是「独立窗口 + 系统标题栏风格」，
    与本项目的莫兰迪浅绿 + 磨砂玻璃语言完全不搭：
    - 它有自己的固定配色，不读项目的 Token
    - 它以独立窗口弹出，位置跟随屏幕而非主窗口，多显示器时会跑偏
    - 圆角、阴影、字重都是库内写死的，无法调

    这里改用「主窗口内的自绘浮层」：
    - 颜色全部走 Semantic / Glass Token，与界面其余部分同源
    - 绝对定位于主窗口顶部居中，永不跑出窗口
    - 圆角、阴影、间距按项目规范，观感统一

    ## 用法

        Toast.Success("已复制：http://192.168.1.5:5200");
        Toast.Error("复制失败");
        Toast.Info("开发中");

    调用方不需要自己找父容器：Toast 会沿 Application.Current.MainWindow
    找到根 Grid 挂上去。
    ============================================================ -->
<UserControl x:Class="Jvedio.Controls.Toast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Panel.ZIndex="9999"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             IsHitTestVisible="False"
             Visibility="Collapsed">

    <Border x:Name="Root"
            Margin="0,18,0,0"
            CornerRadius="10"
            Background="{DynamicResource Glass.Surface.Deep}"
            BorderBrush="{DynamicResource Glass.Border.Top}"
            BorderThickness="1"
            Padding="14,10"
            MaxWidth="560">
        <Border.Effect>
            <DropShadowEffect Color="#3A3A35" BlurRadius="18" ShadowDepth="2"
                              Direction="270" Opacity="0.14" RenderingBias="Quality" />
        </Border.Effect>

        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="-10" />
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 状态图标：用圆点 + 颜色区分，比库里的图标更轻 -->
            <Border x:Name="Dot"
                    Grid.Column="0"
                    Width="8" Height="8"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Background="{DynamicResource Semantic.Success}" />

            <TextBlock x:Name="Message"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource Glass.Foreground}" />
        </Grid>
    </Border>
</UserControl>
