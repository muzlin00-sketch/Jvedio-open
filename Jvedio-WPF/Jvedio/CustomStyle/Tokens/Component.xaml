<!--
    ============================================================
    Tokens / Component.xaml —— 第三层：覆盖闭源主题（浅色莫兰迪浅绿）
    ============================================================

    ## 这个文件为什么存在

    界面配色来自闭源 SuperControls.Style 的 DefaultColor.xaml（App.xaml 第 18 行）。
    本项目通过「运行时注入」覆盖同名 key（见 Window_Main.ApplyDesignTokens）。
    必须运行时注入而不是只靠 XAML 合并，因为闭源库的 InitThemes()
    会在启动后重建全部颜色资源，把静态加载的字典覆盖掉。

    ## 为什么只覆盖 35 个而不是全部 370 个

    统计全项目 370 个 DynamicResource key：
    - 35 个是配色类（Background / Foreground / BorderBrush 结尾）
    - 335 个是图标与文本资源（OpenPath / Genre / Rating 等）

    只有配色需要 token 化。图标资源纳入 token 体系没有收益。

    ## 浅色模式适配要点

    - 背景不用纯白，用带暖调的米灰 #F7F7F3，避免刺眼
    - 卡片用近白 #FFFFFF，靠「白度递增 + 极浅边框」建立层次
    - 强调色从高饱和蓝/紫降到莫兰迪浅绿 #87A48E，饱和度约 18%
    - 侧栏/工具栏用极浅灰绿，与内容区形成微弱但可辨的区分
    - 边框用 #DCDCD5，几乎不可见但能定形
-->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 独立字典必须自己 merge 上游，否则找不到 Primitive.* -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Jvedio;Component/CustomStyle/Tokens/Primitive.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================================================
         窗口与面板背景
         ============================================================ -->

    <!-- 窗口底色：米灰画布 -->
    <SolidColorBrush x:Key="Window.Background" Color="{StaticResource Primitive.Neutral.100}" />

    <!-- 标题栏/列表区：近白，与画布区分 -->
    <SolidColorBrush x:Key="Window.Title.Background" Color="{StaticResource Primitive.Neutral.50}" />

    <!-- 标题栏前景 -->
    <SolidColorBrush x:Key="Window.Title.Foreground" Color="{StaticResource Primitive.Neutral.950}" />

    <!-- 标题栏 hover -->
    <SolidColorBrush x:Key="Window.Title.Hover.Background" Color="{StaticResource Primitive.Sage.100}" />
    <SolidColorBrush x:Key="Window.Title.Hover.Deep.Background" Color="{StaticResource Primitive.Sage.200}" />

    <!--
        侧栏：磨砂玻璃（半透明）

        浅色模式的玻璃靠「高白度 + 半透明」体现，而不是压暗：
        - 用 #E6EDF3EF（约 90% 不透明度）而非纯色，
          底层画布与背景图会隐约透出，形成玻璃质感
        - 不透明度不宜低于 70%，否则文字对比度下降、可读性变差
        - 配合右侧 1px 极浅边框表现玻璃截面

        注：WPF 没有 backdrop-filter，无法真正模糊背后内容。
        这里的「磨砂」是视觉近似（半透明 + 边框），不是真实模糊。
    -->
    <SolidColorBrush x:Key="Window.Side.Background" Color="#E6EDF3EF" />
    <SolidColorBrush x:Key="Window.Side.Hover.Background" Color="{StaticResource Primitive.Sage.200}" />

    <!-- 状态栏：与侧栏同族，保持视觉统一 -->
    <SolidColorBrush x:Key="Window.StatusBar.Background" Color="#E6EDF3EF" />
    <SolidColorBrush x:Key="Window.StatusBar.Hover.Background" Color="{StaticResource Primitive.Sage.200}" />

    <!-- 详情页 -->
    <SolidColorBrush x:Key="Window.Detail.Background" Color="{StaticResource Primitive.White}" />
    <SolidColorBrush x:Key="Window.Detail.Foreground" Color="{StaticResource Primitive.Neutral.900}" />

    <!-- 内部对话框：纯白，保证内容可读 -->
    <SolidColorBrush x:Key="Window.InnerDialog.Background" Color="{StaticResource Primitive.White}" />

    <!-- 模糊/遮罩背景 -->
    <SolidColorBrush x:Key="BlurBackground" Color="{StaticResource Primitive.Neutral.100}" />

    <!-- ============================================================
         文字
         ============================================================ -->

    <!-- 主文字：深暖灰，不用纯黑 -->
    <SolidColorBrush x:Key="Window.Foreground" Color="{StaticResource Primitive.Neutral.950}" />

    <!-- 次要文字：日期、副标题 -->
    <SolidColorBrush x:Key="Window.Sub.Foreground" Color="{StaticResource Primitive.Neutral.750}" />

    <!-- 高亮文字：莫兰迪浅绿深调，保证浅底上可读 -->
    <SolidColorBrush x:Key="Common.HighLight.Background" Color="{StaticResource Primitive.Sage.800}" />
    <SolidColorBrush x:Key="Common.HighLight.BorderBrush" Color="{StaticResource Primitive.Sage.700}" />
    <SolidColorBrush x:Key="Common.HighLight.Deep.Background" Color="{StaticResource Primitive.Sage.800}" />

    <!-- ============================================================
         强调与选中 —— 莫兰迪浅绿，全界面唯一强调色
         ============================================================ -->

    <SolidColorBrush x:Key="Button.Selected.BorderBrush" Color="{StaticResource Primitive.Sage.600}" />

    <SolidColorBrush x:Key="Button.Fill.Background" Color="{StaticResource Primitive.Sage.600}" />
    <SolidColorBrush x:Key="Button.Hover.Background" Color="{StaticResource Primitive.Sage.200}" />

    <SolidColorBrush x:Key="CheckBox.Checked.Background" Color="{StaticResource Primitive.Sage.600}" />

    <!-- ============================================================
         列表与菜单
         ============================================================ -->

    <SolidColorBrush x:Key="Menu.Background" Color="{StaticResource Primitive.White}" />
    <SolidColorBrush x:Key="Menu.Hover.Background" Color="{StaticResource Primitive.Sage.100}" />
    <SolidColorBrush x:Key="Menu.Hover.Deep.Background" Color="{StaticResource Primitive.Sage.200}" />

    <SolidColorBrush x:Key="ListBoxItem.Background" Color="{StaticResource Primitive.White}" />
    <SolidColorBrush x:Key="ListBoxItem.Hover.Background" Color="{StaticResource Primitive.Sage.100}" />
    <SolidColorBrush x:Key="ListBoxItem.Selected.Active.Background" Color="{StaticResource Primitive.Sage.200}" />
    <SolidColorBrush x:Key="ListBoxItem.Selected.Active.BorderBrush" Color="{StaticResource Primitive.Sage.600}" />

    <SolidColorBrush x:Key="TabItem.Background" Color="{StaticResource Primitive.Neutral.50}" />

    <!-- ============================================================
         状态
         ============================================================ -->

    <SolidColorBrush x:Key="Control.Disabled.Background" Color="{StaticResource Primitive.Neutral.300}" />

    <SolidColorBrush x:Key="Common.Status.Complete.Background" Color="{StaticResource Primitive.Sage.600}" />
    <SolidColorBrush x:Key="Common.Status.Running.Background" Color="{StaticResource Primitive.Blue.600}" />

    <!-- ============================================================
         圆角（可被 Data/theme.json 覆盖）
         ============================================================ -->

    <CornerRadius x:Key="Card.CornerRadius">6</CornerRadius>
    <CornerRadius x:Key="Card.CornerRadius.Top">6,6,0,0</CornerRadius>
    <CornerRadius x:Key="Card.CornerRadius.Bottom">0,0,6,6</CornerRadius>

    <!--
        卡片信息区磨砂玻璃底色

        铺在「模糊封面」之上形成磨砂观感。浅色模式用高白度半透明：
        - #B8FFFFFF（72% 白）：既压住封面保证文字可读，又保留朦胧感
        - 用白色而非灰绿，避免与封面的暖色调混合后发脏
    -->
    <SolidColorBrush x:Key="Card.Info.Glass" Color="#8CFFFFFF" />
    <CornerRadius x:Key="Radius.Sm">2</CornerRadius>
    <CornerRadius x:Key="Radius.Md">4</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">8</CornerRadius>

    <!-- ============================================================
         字体（可被 Data/theme.json 覆盖）
         ============================================================ -->

    <!-- 识别码等宽字体：让 IPZ-229 / MIRD-190 在网格中形成对齐的视觉列 -->
    <FontFamily x:Key="Font.Family.Code">Consolas, Cascadia Mono, Courier New</FontFamily>

    <!-- ============================================================
         字号（可被 Data/theme.json 覆盖）

         为什么 7 档而不是"想写几号就写几号"：
         原项目散落着 11/12/13/14/15/16 六种值，
         其中 12 与 13、14 与 15 肉眼几乎无法分辨，
         属于随手写数字而非有意设计。收敛成固定档位后，
         调整字号只需改一处，且能保证层级关系一致。
         ============================================================ -->

    <sys:Double x:Key="Font.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Font.Size.BodySm">12</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.BodyMd">14</sys:Double>
    <sys:Double x:Key="Font.Size.BodyLg">15</sys:Double>
    <sys:Double x:Key="Font.Size.Title">16</sys:Double>
    <sys:Double x:Key="Font.Size.Code">15</sys:Double>

    <!-- ============================================================
         字重（可被 Data/theme.json 覆盖）
         ============================================================ -->

    <FontWeight x:Key="Font.Weight.Normal">Normal</FontWeight>
    <FontWeight x:Key="Font.Weight.Medium">Medium</FontWeight>
    <FontWeight x:Key="Font.Weight.Bold">Bold</FontWeight>

    <!-- ============================================================
         间距（Thickness，供 Margin / Padding 使用）
         ============================================================ -->

    <Thickness x:Key="Space.Inset.CardText">12,0,0,0</Thickness>
    <Thickness x:Key="Space.Inset.CardId">0,7</Thickness>
    <Thickness x:Key="Space.Inset.CardDate">0,5</Thickness>
    <Thickness x:Key="Space.Inset.CardTag">0,5,5,0</Thickness>
    <Thickness x:Key="Space.Inset.CardImage">2.5</Thickness>
    <Thickness x:Key="Space.Inset.Sm">4</Thickness>
    <Thickness x:Key="Space.Inset.Md">8</Thickness>
    <Thickness x:Key="Space.Inset.Lg">12</Thickness>

    <!-- 兜底 key -->
    <SolidColorBrush x:Key="Background" Color="{StaticResource Primitive.Neutral.100}" />
    <SolidColorBrush x:Key="Foreground" Color="{StaticResource Primitive.Neutral.950}" />

</ResourceDictionary>
