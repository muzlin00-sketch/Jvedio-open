<!--
    ============================================================
    Tokens / Primitive.xaml —— 第一层：原始色值（莫兰迪浅绿）
    ============================================================

    ## 莫兰迪色系的特征

    - 低饱和度：每个颜色都掺灰，不刺眼
    - 明度接近：相邻层级差异小，整体柔和统一
    - 冷暖平衡：没有强烈对抗

    饱和度控制在 12%-28% 区间（普通 UI 配色常到 60%-90%）。

    ## 为什么主色选浅绿

    用户主要使用浅色模式。浅色底 + 莫兰迪浅绿（灰调鼠尾草绿）
    的组合观感最柔和：绿色在低饱和时接近中性色，
    不会像蓝/紫那样在浅底上显得"发灰发脏"。

    参考：Giorgio Morandi 静物画中的灰绿瓶身。

    这一层只给颜色命名，不表达用途；界面不直接引用。
-->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         中性色：暖白纸感骨架（浅色模式）
         不是纯白/纯灰，而是带极轻微暖调的米白，避免冷硬
         ============================================================ -->
    <Color x:Key="Primitive.Neutral.950">#FF3A3A35</Color>
    <Color x:Key="Primitive.Neutral.900">#FF4A4A44</Color>
    <Color x:Key="Primitive.Neutral.850">#FF5C5C55</Color>
    <Color x:Key="Primitive.Neutral.800">#FF6E6E66</Color>
    <Color x:Key="Primitive.Neutral.750">#FF82827A</Color>
    <Color x:Key="Primitive.Neutral.700">#FF96968D</Color>
    <Color x:Key="Primitive.Neutral.600">#FFAAAAA1</Color>
    <Color x:Key="Primitive.Neutral.500">#FFBEBEB5</Color>
    <Color x:Key="Primitive.Neutral.400">#FFCFCFC7</Color>
    <Color x:Key="Primitive.Neutral.300">#FFDCDCD5</Color>
    <Color x:Key="Primitive.Neutral.200">#FFE7E7E1</Color>
    <Color x:Key="Primitive.Neutral.100">#FFF0F0EB</Color>
    <Color x:Key="Primitive.Neutral.50">#FFF7F7F3</Color>

    <!-- ============================================================
         莫兰迪主色：浅绿（Dusty Sage）
         饱和度约 18%，是整界面唯一的强调色
         ============================================================ -->
    <Color x:Key="Primitive.Sage.800">#FF5A7A63</Color>
    <Color x:Key="Primitive.Sage.700">#FF6E8F77</Color>
    <Color x:Key="Primitive.Sage.600">#FF87A48E</Color>
    <Color x:Key="Primitive.Sage.500">#FF9DB8A4</Color>
    <Color x:Key="Primitive.Sage.400">#FFB3CAB9</Color>
    <Color x:Key="Primitive.Sage.300">#FFC9DBD0</Color>
    <Color x:Key="Primitive.Sage.200">#FFDDE9E1</Color>
    <Color x:Key="Primitive.Sage.100">#FFEDF3EF</Color>

    <!-- 莫兰迪辅色：灰蓝（Dusty Blue）——信息态 -->
    <Color x:Key="Primitive.Blue.700">#FF6B7F8C</Color>
    <Color x:Key="Primitive.Blue.600">#FF8095A3</Color>
    <Color x:Key="Primitive.Blue.500">#FF97AAB6</Color>

    <!-- 莫兰迪辅色：灰粉（Dusty Rose）——强调/新加入 -->
    <Color x:Key="Primitive.Rose.700">#FF9E6B70</Color>
    <Color x:Key="Primitive.Rose.600">#FFB08085</Color>
    <Color x:Key="Primitive.Rose.500">#FFC0949A</Color>

    <!-- 莫兰迪辅色：灰黄（Sand）——警告态 -->
    <Color x:Key="Primitive.Amber.700">#FFA89370</Color>
    <Color x:Key="Primitive.Amber.600">#FFC0AC8B</Color>

    <!-- 莫兰迪辅色：灰红（Terracotta）——错误态 -->
    <Color x:Key="Primitive.Red.700">#FF9C6B63</Color>
    <Color x:Key="Primitive.Red.600">#FFB5837A</Color>

    <!-- 纯色 -->
    <Color x:Key="Primitive.White">#FFFFFFFF</Color>
    <Color x:Key="Primitive.Black">#FF000000</Color>

</ResourceDictionary>
