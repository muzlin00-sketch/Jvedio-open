    为什么不直接用 ProjectReference：
    本项目是 MSBuild 2003 格式（根节点带 xmlns），而 Jvedio.Core 是
    SDK 风格项目，两者无法在同一构建中互相引用（会报 MSB4041）。
    因此这里直接引用已构建的 netstandard2.0 程序集。

    构建顺序：先构建 Jvedio.Core，再构建本项目。build.ps1 已处理。

    源文件策略：Core 通过 link 引用本项目的 .cs 文件（单一真相），
    因此这些文件已从本项目的 Compile 列表中移除，类型由 Core 提供。
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\Jvedio.Core\bin\$(Configuration)\netstandard2.0\Jvedio.Core.dll')">
    <!--
      引用 netstandard2.0 库时，net472 项目必须同时引用 netstandard 门面程序集，
      否则会报 CS0012「类型在未引用的程序集中定义」。
      门面来自 NuGet 的参考程序集包（本机未装 VS，无系统 Facades 目录）。
    -->
    <Reference Include="netstandard">
      <HintPath>$(MSBuildThisFileDirectory)..\packages\Microsoft.NETFramework.ReferenceAssemblies.net472.1.0.3\build\.NETFramework\v4.7.2\Facades\netstandard.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!--
      必须按 $(Configuration) 取对应版本，不能固定取 Release。
      早期写成「优先 Release、缺失才用 Debug」，导致 Debug 构建时：
      - 引用的仍是旧的 Release 版 Jvedio.Core.dll
      - 对 Core 内文件（HttpProtocol 等）的修改永远编译不进去
      - 表现为「改了代码但行为不变」，极难排查
    -->
    <Reference Include="Jvedio.Core">
      <HintPath>$(MSBuildThisFileDirectory)..\Jvedio.Core\bin\$(Configuration)\netstandard2.0\Jvedio.Core.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <!-- 兜底：目标 Configuration 的 Core 尚未构建时，退到另一种配置，避免编译直接失败 -->
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\Jvedio.Core\bin\$(Configuration)\netstandard2.0\Jvedio.Core.dll') AND Exists('$(MSBuildThisFileDirectory)..\Jvedio.Core\bin\Release\netstandard2.0\Jvedio.Core.dll')">
    <Reference Include="netstandard">
      <HintPath>$(MSBuildThisFileDirectory)..\packages\Microsoft.NETFramework.ReferenceAssemblies.net472.1.0.3\build\.NETFramework\v4.7.2\Facades\netstandard.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Jvedio.Core">
      <HintPath>$(MSBuildThisFileDirectory)..\Jvedio.Core\bin\Release\netstandard2.0\Jvedio.Core.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\Jvedio.Core\bin\$(Configuration)\netstandard2.0\Jvedio.Core.dll') AND !Exists('$(MSBuildThisFileDirectory)..\Jvedio.Core\bin\Release\netstandard2.0\Jvedio.Core.dll') AND Exists('$(MSBuildThisFileDirectory)..\Jvedio.Core\bin\Debug\netstandard2.0\Jvedio.Core.dll')">
    <Reference Include="netstandard">
      <HintPath>$(MSBuildThisFileDirectory)..\packages\Microsoft.NETFramework.ReferenceAssemblies.net472.1.0.3\build\.NETFramework\v4.7.2\Facades\netstandard.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Jvedio.Core">
      <HintPath>$(MSBuildThisFileDirectory)..\Jvedio.Core\bin\Debug\netstandard2.0\Jvedio.Core.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
